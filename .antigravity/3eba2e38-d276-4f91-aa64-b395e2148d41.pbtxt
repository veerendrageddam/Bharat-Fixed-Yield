              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  const netMaturityWithTds = form15HSubmitted ? maturityAmount : maturityAmount - estimatedTdsYear3;"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  return {"
